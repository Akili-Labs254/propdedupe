# Copy this file to .env and fill in real values. NEVER commit .env.

# ── Supabase / Postgres ──
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_KEY= admin_key
# Or a direct Postgres connection string instead of the two above:
DATABASE_URL=

# ── Scraper politeness ──
# Identify your bot honestly; put a real contact so site owners can reach you.
SCRAPER_USER_AGENT=PropDeDupe/0.1 (student portfolio project; contact: you@example.com)
# Seconds to wait between requests — don't hammer the sites.
REQUEST_DELAY_SECONDS=2
