# Copy this file to .env and fill in real values. NEVER commit .env.

# ── Supabase / Postgres ──
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_KEY= admin_key
# Or a direct Postgres connection string instead of the two above:
DATABASE_URL=

# ── Scraper politeness ──
# Identify your bot honestly, with a real contact so site owners can reach
# you. Leave unset to use the default in backend/common/config.py.
# SCRAPER_USER_AGENT=YourBot/1.0 (+https://your-site.example; contact: you@your-domain.example)
# Seconds to wait between requests. Don't hammer the sites.
REQUEST_DELAY_SECONDS=5
