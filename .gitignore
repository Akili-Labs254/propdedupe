# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── Virtual environments ──
.venv/
venv/
env/

# ── Secrets & local config ──
.env
.env.*
!.env.example
render.yaml

# ── Scraped data & local scratch (keep the folder, ignore its contents) ──
data/*
!data/.gitkeep

# ── Run logs (long refresh runs are tee'd here) ──
logs/*
!logs/.gitkeep

# ── Editor / OS ──
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Private: personal notes and marketing drafts (never public) ──
notes/
gtm/
*tiktok*.md
x-link-post-*.md
