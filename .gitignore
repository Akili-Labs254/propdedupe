# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── Virtual environments ──
.venv/
venv/
env/

# ── Secrets & local config ──
.env

# ── Scraped data & local scratch (keep the folder, ignore its contents) ──
data/*
!data/.gitkeep

# ── Run logs (long refresh runs are tee'd here) ──
logs/*
!logs/.gitkeep

# ── Editor / OS ──
.vscode/
.idea/
.DS_Store
Thumbs.db
gtm/
render.yaml
